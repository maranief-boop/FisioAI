# Chave da API Google Gemini (Google AI Studio)
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=sua_chave_aqui

# ID do vídeo do YouTube com o tutorial de como gerar a chave (30-60s).
# Pegue a parte "v=..." da URL do vídeo.
# Ex.: https://www.youtube.com/watch?v=dQw4w9WgXcQ  ->  VITE_TUTORIAL_VIDEO_ID=dQw4w9WgXcQ
VITE_TUTORIAL_VIDEO_ID=

# Supabase (validação de assinatura / acesso)
# Crie um projeto em https://supabase.com -> Project Settings -> API
# URL do projeto + chave pública "anon" (segura para o frontend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------- Secrets das Edge Functions (painel do Supabase) -------------------
# Em Project Settings -> Edge Functions -> Secrets, defina:
#
# KIWIFY_WEBHOOK_TOKEN = token definido na configuração do webhook da Kiwify
#   (dashboard.kiwify.com.br -> Apps -> Webhooks -> "Token")
#
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são injetados automaticamente
# pelo Supabase em toda Edge Function.
